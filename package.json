{
  "name": "xata-cli",
  "description": "Xata CLI",
  "version": "1.4.19",
  "private": true,
  "module": "src/app.ts",
  "type": "module",
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/treeify": "1.0.3",
    "@xata.io/test-utils": "0.0.5"
  },
  "peerDependencies": {
    "typescript": "6.0.x"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.17.4",
    "@stricli/auto-complete": "1.3.0",
    "@stricli/core": "1.3.0",
    "chalk": "5.6.2",
    "chrono-node": "2.10.1",
    "cli-table3": "0.6.5",
    "dedent": "1.7.2",
    "enquirer": "2.4.1",
    "@vercel/detect-agent": "1.2.3",
    "ci-info": "4.4.0",
    "is-reachable": "6.1.0",
    "jose": "6.2.4",
    "pg-connection-string": "2.14.0",
    "postgres": "3.4.9",
    "strip-ansi": "7.2.0",
    "tiny-invariant": "1.3.3",
    "treeify": "1.1.0",
    "ts-pattern": "5.9.0",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zod-config": "1.4.0",
    "@xata.io/ai": "0.1.1",
    "@xata.io/api": "0.1.4",
    "@xata.io/config": "0.0.4",
    "@xata.io/lang": "0.0.3",
    "@xata.io/pgroll": "0.9.1",
    "@xata.io/pgstream": "0.2.1",
    "@xata.io/sql": "0.1.7",
    "@xata.io/tsconfig": "0.0.2",
    "@xata.io/utils": "0.1.2"
  },
  "scripts": {
    "dev": "bun src/bin/cli.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "test-unit": "bun test unit.test",
    "test-integration": "bun test --concurrent --parallel=15 --timeout 90000 integration.test",
    "test-binary-e2e": "bun test --concurrent --timeout 90000 test-binary/e2e",
    "test:watch": "bun test --watch",
    "release": "bun run build && bun scripts/release.ts",
    "tsc": "tsc"
  }
}