{
  "name": "xata-cli",
  "description": "Xata CLI",
  "version": "1.1.4",
  "private": true,
  "module": "src/app.ts",
  "type": "module",
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1029.0",
    "@types/bun": "1.3.12",
    "@types/node": "25.6.0",
    "@types/treeify": "1.0.3"
  },
  "peerDependencies": {
    "typescript": "5.9.x"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.61.0",
    "@stricli/auto-complete": "1.2.6",
    "@stricli/core": "1.2.6",
    "chalk": "5.6.2",
    "chrono-node": "2.9.0",
    "cli-table3": "0.6.5",
    "dedent": "1.7.2",
    "enquirer": "2.4.1",
    "@vercel/detect-agent": "1.2.2",
    "ci-info": "4.4.0",
    "is-reachable": "6.1.0",
    "jose": "6.2.2",
    "pg-connection-string": "2.12.0",
    "postgres": "3.4.9",
    "strip-ansi": "7.2.0",
    "tiny-invariant": "1.3.3",
    "treeify": "1.1.0",
    "ts-pattern": "5.9.0",
    "yaml": "2.8.3",
    "zod": "4.3.6",
    "zod-config": "1.4.0",
    "@xata.io/ai": "0.1.0",
    "@xata.io/api": "0.1.0",
    "@xata.io/config": "0.0.0",
    "@xata.io/lang": "0.0.1",
    "@xata.io/pgroll": "0.9.0",
    "@xata.io/pgstream": "0.2.0",
    "@xata.io/sql": "0.1.3",
    "@xata.io/tsconfig": "0.0.1",
    "@xata.io/utils": "0.1.0"
  },
  "scripts": {
    "dev": "bun src/bin/cli.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "test-unit": "bun test unit.test",
    "test-integration": "bun test --timeout 30000 integration.test",
    "test-binary-e2e": "bun test test-binary/e2e",
    "test:watch": "bun test --watch",
    "release": "bun run build && bun scripts/release.ts",
    "tsc": "tsc"
  }
}