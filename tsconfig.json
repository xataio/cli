{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@xata.io/tsconfig/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node", "bun"],
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
